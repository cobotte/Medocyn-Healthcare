# ============================================================
# MEDOCYN HEALTHCARE — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
#
# Generate a secure JWT secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================

# ─── Database ─────────────────────────────────────────────
# SQLite database file path (relative to project root)
DATABASE_URL="file:./prisma/dev.db"

# ─── Authentication ────────────────────────────────────────
# JWT signing secret — MUST be at least 32 characters
# Use a cryptographically random value in production
JWT_SECRET="your-secure-random-256-bit-secret-here"

# ─── Runtime Environment ───────────────────────────────────
# Set to "production" for deployment
NODE_ENV="development"

# ─── Optional: Email (if adding email notifications later) ─
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="noreply@medocyn.com"
# SMTP_PASS="your-smtp-password"
# SMTP_FROM="Medocyn Healthcare <noreply@medocyn.com>"
