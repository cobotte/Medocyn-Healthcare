# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Next.js build output
/.next/
/out/

# Production
/build

# Dependencies
node_modules/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Generated Next internals accidentally emitted by tooling
src/app/*--route-entry.js

# Local inspection scratch data
scratch_*.json

# Prisma generated files
/src/generated/prisma

# SQLite database files (local dev only)
*.db
*.db-journal
*.db-shm
*.db-wal

# OS files
.DS_Store
Thumbs.db

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Word docs / temp files
*.docx
*~$*
*~*

# History log (generated automatically)
history.log
